# Copy this file to backend/.env. The backend loads backend/.env by default.
# Do not add real values to this file or commit backend/.env.

# Required by the dgx system provider in backend/config/llm.json.
BIOFLOW_LLM_API_KEY_DGX=

# Optional: the opencode-go-2 provider in backend/config/llm.json. Only needed when a role
# is bound to it (the provider also requires the x-opencode-session header in that file).
BIOFLOW_LLM_API_KEY_OPENCODE_GO_2=

# Required while the corresponding default MCP server is enabled in backend/config/mcp.json.
BIOFLOW_TAVILY_API_KEY=
BIOFLOW_MCP_EXA_X_API_KEY=
BIOFLOW_MCP_CONTEXT7_API_KEY=

# Optional runtime overrides.
PORT=3000
BIOFLOW_CONFIG_DIR=
BIOAGENT_PYTHON=
BIOAGENT_ENV_BIN=
WEB_ROOT=
# 意见反馈（仅登录版，需 BIOFLOW_AUTH_ENABLED=1）：SQLite 文件，默认 workspace/feedback.sqlite。
# BIOFLOW_FEEDBACK_DB=

# Optional: only when the seqera MCP server is enabled (disabled by default).
# BIOFLOW_MCP_SEQERA_ACCESS_TOKEN=

# ---- 登录鉴权（只在部署实例开启；开发实例保持不设置）----
# 打开后所有 /api（除登录/注册/找回/健康检查）都需要会话；未登录返回 401。
# 启动命令必须带 --experimental-sqlite（npm scripts 与 bin/bioflow.mjs 已处理）。
# BIOFLOW_AUTH_ENABLED=1
# BIOFLOW_AUTH_DB=
# BIOFLOW_AUTH_ADMIN_EMAILS=name@example.com
# BIOFLOW_AUTH_COOKIE_SECURE=1
# 用户 LLM API key 的加密主密钥（32 字节 base64）；不设置则自动生成 auth-secret.key。
# BIOFLOW_AUTH_ENCRYPTION_KEY=
#
# 验证码邮件（QQ 邮箱示例：465 + 授权码，不是登录密码）
# BIOFLOW_AUTH_SMTP_HOST=smtp.qq.com
# BIOFLOW_AUTH_SMTP_PORT=465
# BIOFLOW_AUTH_SMTP_USER=xxxx@qq.com
# BIOFLOW_AUTH_SMTP_PASS=
# BIOFLOW_AUTH_MAIL_FROM=xxxx@qq.com
# BIOFLOW_AUTH_MAIL_FROM_NAME=Bioflow

