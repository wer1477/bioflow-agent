{
  "schemaVersion": 1,
  "enabled": true,
  "service": {
    "baseUrl": "http://127.0.0.1:8790",
    "autoStart": true,
    "startupTimeoutMs": 180000,
    "requestTimeoutMs": 2000,
    "contextTimeoutMs": 3000,
    "pairTimeoutMs": 8000
  },
  "runtime": {
    "python": "${BIOFLOW_BIOD_PYTHON}",
    "repoRoot": "${BIOFLOW_BIOD_REPO}",
    "ckptDir": "${BIOFLOW_BIOD_CKPT}",
    "device": "cuda",
    "dtype": "bfloat16",
    "entry": "biod.multitask.serve"
  },
  "model": {
    "expectedVersion": "biod-mt-v2"
  },
  "decisionPoints": {
    "tool_select": {
      "mode": "off",
      "tau": 0.1
    },
    "kb_select": {
      "mode": "select",
      "tau": 0.1078,
      "topK": 3
    },
    "context_retention": {
      "mode": "select",
      "maxGroups": 12
    },
    "role_select": {
      "mode": "select",
      "tau": 0.6
    },
    "relay_select": {
      "mode": "select",
      "floor": 0.75
    }
  },
  "framework": {
    "enabled": true,
    "defaultMode": "off",
    "decisionPoints": {
      "s2.premise": {
        "mode": "assist",
        "scorer": "http",
        "budget": "short"
      },
      "s2.rerank": {
        "mode": "assist",
        "scorer": "heuristic",
        "budget": "long"
      },
      "s2.policy": {
        "mode": "assist",
        "budget": "rule"
      },
      "s3.trigger": {
        "mode": "off",
        "budget": "rule"
      },
      "s5.diversity": {
        "mode": "off",
        "budget": "rule"
      }
    },
    "researcher": {
      "enabled": true,
      "thresholds": {
        "tauBetter": 0.55,
        "tauMissing": 0.55,
        "margin": 0.08,
        "minConfidence": 0.5,
        "topK": 3
      },
      "prefilter": {
        "mode": "lexical",
        "maxCandidates": 16
      },
      "decisionPoints": {
        "r1.plan-audit": {
          "mode": "assist",
          "scorer": "http",
          "budget": "audit"
        }
      }
    },
    "writer": {
      "enabled": true,
      "thresholds": {
        "minConfidence": 0.55,
        "tauMismatch": 0.65,
        "tauPartial": 0.5,
        "overclaimConfidence": 0.6,
        "topIssues": 10
      },
      "precheck": {
        "online": false,
        "maxQuoteChars": 800
      },
      "decisionPoints": {
        "w1.claim-evidence-audit": {
          "mode": "assist",
          "scorer": "http",
          "budget": "claim-audit"
        }
      }
    },
    "reviewer": {
      "enabled": true,
      "thresholds": {
        "minConfidence": 0.55,
        "tauContradicted": 0.65,
        "tauHolds": 0.55,
        "ownerMargin": 0.15,
        "pairMargin": 0.05,
        "duplicateThreshold": 0.7,
        "maxPairwiseIssues": 8,
        "maxScoredIssues": 64,
        "topIssues": 10
      },
      "decisionPoints": {
        "v1.issue-triage": {
          "mode": "assist",
          "scorer": "http",
          "budget": "issue-audit"
        }
      }
    }
  },
  "state": {
    "maxChars": 640
  }
}
