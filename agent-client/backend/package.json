{
  "name": "agent-client-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx src/index.ts",
    "dev:watch": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "test": "NODE_OPTIONS=--experimental-sqlite tsx --test --import ./test/setup-test-workspace.mjs test/**/*.test.ts",
    "probe:presets": "node scripts/probe-presets.mjs",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "nodemailer": "^10.3.1",
    "openai": "^6.47.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^11.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
