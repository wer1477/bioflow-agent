{
  "schemaVersion": 1,
  "enabled": true,
  "service": {
    "baseUrl": "http://127.0.0.1:8790",
    "autoStart": true,
    "startupTimeoutMs": 180000,
    "requestTimeoutMs": 2000,
    "contextTimeoutMs": 3000,
    "pairTimeoutMs": 8000
  },
  "runtime": {
    "python": "${BIOFLOW_BIOD_PYTHON}",
    "repoRoot": "${BIOFLOW_BIOD_REPO}",
    "ckptDir": "${BIOFLOW_BIOD_CKPT}",
    "device": "cuda",
    "dtype": "bfloat16",
    "entry": "biod.multitask.serve"
  },
  "model": {
    "expectedVersion": "biod-mt-v2"
  },
  "decisionPoints": {
    "tool_select": {
      "mode": "off",
      "tau": 0.1
    },
    "kb_select": {
      "mode": "select",
      "tau": 0.1078,
      "topK": 3
    },
    "context_retention": {
      "mode": "select",
      "maxGroups": 12
    },
    "role_select": {
      "mode": "select",
      "tau": 0.6
    },
    "relay_select": {
      "mode": "select",
      "floor": 0.75
    }
  },
  "state": {
    "maxChars": 640
  }
}
